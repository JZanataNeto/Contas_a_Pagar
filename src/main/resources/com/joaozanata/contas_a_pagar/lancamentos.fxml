         <Insets left="15.0" top="20.0" />
      </VBox.margin>
      <DatePicker fx:id="dpVencimento" />
      <TextField fx:id="txtDescricao" promptText="descricao" />
      <TextField fx:id="txtForma" promptText="forma" />
      <TextField fx:id="txtParcela" promptText="parcela" />
      <TextField fx:id="txtStatus" onAction="#atualizarTotais" promptText="status" />
      <TextField fx:id="txtValor" onAction="#atualizarTotais" promptText="valor" />
   </HBox>
   <HBox alignment="CENTER" prefHeight="60.0" prefWidth="800.0" spacing="40.0" style="-fx-background-color: #55606d;">
      <VBox.margin>
         <Insets />
      </VBox.margin>
      <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#salvar" style="-fx-background-color: #4f46e5;" text="Salvar" textFill="WHITE" />
      <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#atualizar" style="-fx-background-color: #4f46e5;" text="Atualizar" textFill="WHITE" />
      <Button fx:id="btnApagar" mnemonicParsing="false" onAction="#apagar" style="-fx-background-color: #4f46e5;" text="Apagar" textFill="WHITE" />
      <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#limpar" style="-fx-background-color: #4f46e5;" text="Limpar" textFill="WHITE" />
   </HBox>
   <HBox prefHeight="540.0" prefWidth="800.0">
      <TableView fx:id="tblContas" prefHeight="540.0" prefWidth="800.0" style="-fx-background-color: #eef0f2;">
         <columns>
            <TableColumn fx:id="clData" prefWidth="150.0" text="Data" />
            <TableColumn fx:id="clDescricao" prefWidth="200.0" text="Descrição" />
            <TableColumn fx:id="clForma" prefWidth="200.0" text="Forma" />
            <TableColumn fx:id="clParcela" text="Parcela" />
            <TableColumn fx:id="clStatus" text="Status" />
            <TableColumn fx:id="clValor" prefWidth="90.0" text="Valor" />
         </columns>
      </TableView>
      <VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="210.0" spacing="10.0" style="-fx-background-color: #55606d;">
